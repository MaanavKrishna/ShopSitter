# LLM
ANTHROPIC_API_KEY=your-api-key
VISION_MODEL=claude-sonnet-5-5
ASK_MODEL=claude-haiku-5-5

# PayPal (sandbox only)
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret

# Storage: "file" (local .data/ folder) or "postgres" (hosted)
REPO=file
# Set automatically by Vercel when you add a Postgres database to the project
DATABASE_URL=postgres://user:password@host/database

# Access
OWNER_PASSCODE=choose-a-passcode
DEMO_PASSCODE=demo
STAND_TOKEN=choose-a-stand-token
SESSION_SECRET=a-long-random-string
