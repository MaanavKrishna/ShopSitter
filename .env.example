# LLM
ANTHROPIC_API_KEY=your-api-key
VISION_MODEL=claude-sonnet-5-5
ASK_MODEL=claude-haiku-5-5

# PayPal (sandbox only)
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret
PAYPAL_ENV=sandbox

# Storage: "file" (local .data/ folder) or "supabase"
REPO=file
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Access
OWNER_PASSCODE=choose-a-passcode
DEMO_PASSCODE=demo
STAND_TOKEN=choose-a-stand-token
SESSION_SECRET=a-long-random-string
CRON_SECRET=another-long-random-string

NEXT_PUBLIC_BASE_URL=http://localhost:3210
